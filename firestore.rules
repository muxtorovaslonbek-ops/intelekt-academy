rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'muxtorovaslonbek@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validators
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 100 &&
        data.lastName is string && data.lastName.size() <= 100 &&
        data.role in ['student', 'admin'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('telegramHandle' in data) || (data.telegramHandle is string && data.telegramHandle.size() <= 60)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    function isValidCourse(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.category is string && data.category.size() <= 100 &&
        data.instructor is string && data.instructor.size() <= 100;
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 3000 &&
        data.category in ['important', 'news', 'system', 'update'] &&
        data.author is string && data.author.size() <= 100;
    }

    function isValidFeedback(data) {
      return data.id is string && data.id.size() <= 128 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        data.userName is string && data.userName.size() <= 100 &&
        data.type in ['suggestion', 'request', 'opinion', 'comment', 'complaint', 'question'] &&
        data.subject is string && data.subject.size() <= 200 &&
        data.message is string && data.message.size() <= 3000 &&
        data.status in ['new', 'reviewed', 'resolved'] &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
        (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 50)) &&
        (!('userTelegram' in data) || (data.userTelegram is string && data.userTelegram.size() <= 60)) &&
        (!('rating' in data) || (data.rating is number)) &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 3000)) &&
        (!('adminRepliedAt' in data) || (data.adminRepliedAt is string && data.adminRepliedAt.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    function isValidTestResult(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string &&
        data.quizId is string && data.quizId.size() <= 100 &&
        data.score is number &&
        data.totalQuestions is number &&
        data.percentage is number &&
        data.passed is bool;
    }

    // Health check test connection endpoint
    match /test/connection {
      allow get: if true;
    }

    // Admin authorization docs
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) &&
        isValidUser(incoming());
      allow update: if isValidUser(incoming());
      allow delete: if true;
    }

    // Courses Collection
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update: if isValidCourse(incoming());
      allow delete: if true;
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update: if isValidAnnouncement(incoming());
      allow delete: if true;
    }

    // Feedbacks Collection
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if isValidId(feedbackId) && isValidFeedback(incoming());
      allow update: if true;
      allow delete: if true;
    }

    // Test Results Collection
    match /test_results/{resultId} {
      allow get, list: if true;
      allow create: if isValidId(resultId) && isValidTestResult(incoming());
      allow update, delete: if true;
    }
  }
}
