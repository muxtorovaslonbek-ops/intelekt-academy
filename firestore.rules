rules_version = '2';

// ============================================================================
// XAVFSIZLIK: Bu loyihaning frontend kodi Firestore'dan HECH QANDAY joyda
// foydalanmaydi (src/lib/firebase.ts fayli hech qayerda import qilinmagan —
// haqiqiy autentifikatsiya va ma'lumotlar Supabase orqali ishlaydi).
//
// Lekin firebase-applet-config.json fayli (projectId, apiKey va h.k.) ochiq
// JS bundle ichida ekan, istalgan kishi shu ma'lumotlar bilan o'zining
// Firebase SDK orqali to'g'ridan-to'g'ri sizning Firestore bazangizga
// ulanishi mumkin edi. Avvalgi qoidalarda:
//   - /admins/{id} ga "allow write: if true" bo'lgani uchun HAR KIM o'zini
//     admin qilib yoza olardi;
//   - barcha kolleksiyalarda "allow delete: if true" bo'lgani uchun HAR KIM
//     butun bazani o'chirib yubora olardi.
//
// Ilova Firestore'ni umuman ishlatmagani uchun, eng xavfsiz yechim —
// bazaga UMUMAN kirishni yopib qo'yish. Bu ilovaning ishlashiga hech qanday
// ta'sir qilmaydi (chunki kod uni chaqirmaydi).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
