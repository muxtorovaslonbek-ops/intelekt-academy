# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Auth & Database Credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# YANGI: faqat SERVERDA ishlatiladigan sirlar (Vercel Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Backend API configuration
VITE_API_BASE_URL=http://localhost:4000/api
PORT=4000

# Bunny.net media storage
BUNNY_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_REGION=de
BUNNY_BASE_URL=https://storage.bunnycdn.com
BUNNY_CDN_URL=https://your-pull-zone.b-cdn.net

# Telegram bot token (server-only; never use VITE_ prefix)
TELEGRAM_BOT_TOKEN=
